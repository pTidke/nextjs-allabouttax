        },
        "top": {
          "title": "Top",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "bottom": {
          "title": "Bottom",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "top",
        "x1",
        "bottom"
      ],
      "title": "Box",
      "type": "object"
    },
    "Cell": {
      "additionalProperties": false,
      "properties": {
        "row": {
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "title": "Column",
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "None means the reader gave no value, not a blank.",
          "title": "Text"
        },
        "box": {
          "anyOf": [
            {
              "$ref": "#/$defs/Box"
            },
            {
              "type": "null"
            }
          ],
          "default": null
