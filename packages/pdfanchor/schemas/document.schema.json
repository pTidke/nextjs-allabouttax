        "status": {
          "default": "flagged",
          "enum": [
            "accepted",
            "flagged",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/Flag"
          },
          "title": "Flags",
          "type": "array"
        },
        "excluded": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reason this line is kept as evidence but left out of exports.",
          "title": "Excluded"
        }
      },
      "required": [
        "id",
        "page",
        "order",
        "box",
        "raw",
        "text",
        "source"
      ],
