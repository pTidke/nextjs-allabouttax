        "name",
        "version",
        "policy_version",
        "config_sha256",
        "components"
      ],
      "title": "Engine",
      "type": "object"
    },
    "Flag": {
      "additionalProperties": false,
      "description": "Why a rule did not accept something. `rule` is a stable identifier.",
      "properties": {
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "severity": {
          "enum": [
            "review",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "severity",
        "message"
      ],
      "title": "Flag",
      "type": "object"
    },
    "Line": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "box": {
          "$ref": "#/$defs/Box"
        },
        "raw": {
          "description": "Exactly what the reader returned.",
          "title": "Raw",
          "type": "string"
        },
        "text": {
          "description": "NFC-normalised `raw`. No other change is ever made.",
          "title": "Text",
          "type": "string"
        },
        "source": {
          "description": "\"native\" or \"ocr:<engine>\".",
          "title": "Source",
          "type": "string"
        },
        "readings": {
          "items": {
            "$ref": "#/$defs/Reading"
          },
          "title": "Readings",
          "type": "array"
        },
        "font_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size"
        },
        "bold": {
          "default": false,
          "title": "Bold",
          "type": "boolean"
        },
        "scripts": {
          "items": {
            "type": "string"
          },
          "title": "Scripts",
          "type": "array"
        },
        "role": {
          "default": "body",
          "enum": [
            "heading",
            "body",
            "table"
          ],
          "title": "Role",
          "type": "string"
        },
        "paragraph": {
          "default": 0,
          "title": "Paragraph",
          "type": "integer"
        },
        "table_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Id"
