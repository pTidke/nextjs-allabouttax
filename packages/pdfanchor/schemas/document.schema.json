      },
      "required": [
        "row",
        "column",
        "text"
      ],
      "title": "Cell",
      "type": "object"
    },
    "Engine": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "config_sha256": {
          "title": "Config Sha256",
          "type": "string"
        },
        "components": {
          "additionalProperties": {
            "type": "string"
          },
