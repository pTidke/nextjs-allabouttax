# Use an isolated development database first. Never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allabouttax_dev
# Required for migration tooling if DATABASE_URL uses Prisma Accelerate.
# DIRECT_URL=postgresql://...
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Azure resource v1 endpoint (not the Foundry project endpoint).
AZURE_OPENAI_BASE_URL=https://pr-allabouttax-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
# Resource key from Azure; server-only. Never use NEXT_PUBLIC_ for credentials.
AZURE_OPENAI_API_KEY=

# Discovery window: defaults to the current calendar year. Review applicability separately.
# TAX_DISCOVERY_START_YEAR=2026
# Maximum cumulative original bytes in Postgres (128 MiB default, not total DB size).
TAX_MAX_ORIGINAL_BYTES=134217728

# Extraction review is disabled until an operator prepares a separate staging database.
EXTRACTION_STAGING_ENABLED=false
# Must differ from DATABASE_URL, including Neon direct/pooled aliases. Server-only.
# EXTRACTION_STAGING_DATABASE_URL=postgresql://.../extraction_staging
# Pin the schema to this environment (8-100 letters, numbers, hyphens or underscores).
# EXTRACTION_STAGING_ENVIRONMENT_ID=allabouttax-extraction-dev
# Absolute PRIVATE directory, outside any static/public server; never a symlink.
# EXTRACTION_STAGING_OBJECT_ROOT=/absolute/path/to/bundle/registry/objects
# Operator import only; Python never runs inside web requests.
# EXTRACTION_STAGING_PYTHON=/absolute/path/to/tools/pdf_pipeline/.venv/bin/python

# Optional private cloud evidence backend; default is local. Never use a public bucket.
# EXTRACTION_STAGING_OBJECT_BACKEND=neon-s3
# Pin these to the independent staging branch, not the production branch.
# EXTRACTION_STAGING_BRANCH_ID=br-STAGING_ID
# Password-free Postgres URL identifying the actual live host/database; guards both staging targets.
# EXTRACTION_STAGING_LIVE_DATABASE_IDENTITY=postgresql://LIVE_HOST/LIVE_DATABASE
# EXTRACTION_STAGING_S3_ENDPOINT=https://br-STAGING_ID.storage.c-2.us-east-2.aws.neon.tech
# EXTRACTION_STAGING_S3_REGION=us-east-2
# EXTRACTION_STAGING_S3_BUCKET=extraction-evidence-staging
# Runtime credential must have storage:read only and be created on the staging branch.
# EXTRACTION_STAGING_S3_ACCESS_KEY_ID=
# EXTRACTION_STAGING_S3_SECRET_ACCESS_KEY=
# Operator upload credentials: keep OFF the web deployment; storage:write on staging only.
# EXTRACTION_STAGING_UPLOAD_ACCESS_KEY_ID=
# EXTRACTION_STAGING_UPLOAD_SECRET_ACCESS_KEY=
