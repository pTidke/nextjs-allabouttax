# Use an isolated development database first. Never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allabouttax_dev
# Required for migration tooling if DATABASE_URL uses Prisma Accelerate.
# DIRECT_URL=postgresql://...
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Azure resource v1 endpoint (not the Foundry project endpoint).
AZURE_OPENAI_BASE_URL=https://pr-allabouttax-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
# Resource key from Azure; server-only. Never use NEXT_PUBLIC_ for credentials.
AZURE_OPENAI_API_KEY=

# Discovery window: defaults to the current calendar year. Review applicability separately.
# TAX_DISCOVERY_START_YEAR=2026
# Maximum cumulative original bytes in Postgres (128 MiB default, not total DB size).
TAX_MAX_ORIGINAL_BYTES=134217728
