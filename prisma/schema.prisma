datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER) // <--- HERE IS THE MAGIC
  accounts      Account[]
  sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AI Usage Tracking
  questionsToday   Int               @default(0)
  lastQuestionAt   DateTime          @default(now())
  taxReviewDrafts  TaxReviewDraft[]
  reviewerGrants   ReviewerGrant[]
  taxConversations TaxConversation[]
  dailyUsage       DailyUsage[]
  threadId         String?
}

// ... (Standard NextAuth tables below)
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Public knowledge is isolated from private conversation data.
model TaxSource {
  id        String         @id
  name      String
  url       String         @unique
  kind      String // DOCUMENT or LISTING
  enabled   Boolean        @default(true)
  checkedAt DateTime?
  lastError String?
  documents TaxDocument[]
  jobs      IngestionJob[]
}

model TaxDocument {
  id              String       @id @default(cuid())
  sourceId        String
  url             String       @unique
  title           String
  latestVersionId String?
  verifiedAt      DateTime?
  lastError       String?
  issuedAt        DateTime?
  source          TaxSource    @relation(fields: [sourceId], references: [id])
  versions        TaxVersion[]
}

model TaxVersion {
  id                String             @id @default(cuid())
  documentId        String
  hash              String
  originalHash      String
  original          Bytes
  contentType       String
  text              String
  fetchedAt         DateTime           @default(now())
  status            String             @default("PENDING")
  reviewNote        String?
  reviewedBy        String?
  reviewedAt        DateTime?
  documentType      String?
  legalStatus       String?
  publishedAt       DateTime?
  period            String? // Used only for SINGLE_PERIOD reviews.
  periodMode        String             @default("SINGLE_PERIOD")
  applicabilityNote String?
  entityName        String?
  investmentFrom    DateTime?
  investmentThrough DateTime? // Inclusive entry deadline, not legal expiry.
  jurisdiction      String?
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  document          TaxDocument        @relation(fields: [documentId], references: [id])
  drafts            TaxReviewDraft[]
  chunks            TaxChunk[]
  extractionReviews ExtractionReview[]

  @@unique([documentId, hash])
}

model TaxChunk {
  id        String     @id @default(cuid())
  versionId String
  anchor    String
  text      String
  version   TaxVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

model KnowledgeRelease {
  sequence   Int      @unique @default(autoincrement())
  id         String   @id @default(cuid())
  versionIds String[]
  createdAt  DateTime @default(now())
  createdBy  String
}

model IngestionJob {
  id            String    @id @default(cuid())
  sourceId      String
  dedupeKey     String    @unique
  status        String    @default("QUEUED")
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  availableAt   DateTime  @default(now())
  leaseUntil    DateTime?
  leaseToken    String?
  finishedAt    DateTime?
  error         String?
  documentUrl   String?
  documentTitle String?
  issuedAt      DateTime?
  result        String?
  source        TaxSource @relation(fields: [sourceId], references: [id])

  @@index([status, availableAt])
}

model TaxConversation {
  id        String       @id @default(cuid())
  userId    String
  period    String
  createdAt DateTime     @default(now())
  messages  TaxMessage[]
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TaxMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           String
  content        String
  citations      Json
  releaseId      String?
  model          String?
  promptVersion  String?
  // Assistant messages only: ANSWERED, CLARIFICATION, UNSUPPORTED or NO_EVIDENCE.
  outcome        String?
  createdAt      DateTime        @default(now())
  conversation   TaxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  gap            TaxContentGap?

  @@index([conversationId, createdAt])
}

// A question the library could not answer. Points at the user's own message, so
// deleting the conversation deletes it too.
model TaxContentGap {
  id        String     @id @default(cuid())
  messageId String     @unique
  period    String
  reason    String // NO_EVIDENCE or UNSUPPORTED
  releaseId String?
  createdAt DateTime   @default(now())
  message   TaxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
}

model DailyUsage {
  userId String
  day    String
  count  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model TaxWorkerState {
  id          String   @id
  heartbeatAt DateTime
  mode        String
}

model TaxReviewDraft {
  versionId String
  userId    String
  fields    Json
  revision  Int        @default(1)
  updatedAt DateTime   @updatedAt
  version   TaxVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([versionId, userId])
}

// Who may review what. EXTRACTION: check extracted text against the original.
// TAX: decide legal applicability and publish. Granted by an administrator; a
// revoked grant keeps its row with revokedAt set.
model ReviewerGrant {
  id        String    @id @default(cuid())
  userId    String
  role      String // EXTRACTION or TAX
  grantedBy String
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// A reviewer's verdict on whether a version's extracted text matches its original.
// Append-only: the newest row for a version is its current state.
model ExtractionReview {
  id         String     @id @default(cuid())
  versionId  String
  reviewerId String
  decision   String // ACCEPTED or NEEDS_CHANGES
  note       String
  createdAt  DateTime   @default(now())
  version    TaxVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt])
}
