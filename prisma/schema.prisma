datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER) // <--- HERE IS THE MAGIC
  accounts      Account[]
  sessions      Session[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AI Usage Tracking
  questionsToday Int      @default(0)
  lastQuestionAt DateTime @default(now())
  taxReviewDrafts TaxReviewDraft[]
  taxConversations TaxConversation[]
  dailyUsage       DailyUsage[]
  threadId       String?
}

// ... (Standard NextAuth tables below)
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}
// Public knowledge is isolated from private conversation data.
model TaxSource {
  id            String   @id
  name          String
  url           String   @unique
  kind          String   // DOCUMENT or LISTING
  enabled       Boolean  @default(true)
  checkedAt     DateTime?
  lastError     String?
  documents     TaxDocument[]
  jobs          IngestionJob[]
}

model TaxDocument {
  id              String   @id @default(cuid())
  sourceId        String
  url             String   @unique
  title           String
  latestVersionId String?
  verifiedAt      DateTime?
  lastError       String?
  issuedAt        DateTime?
  source          TaxSource @relation(fields: [sourceId], references: [id])
  versions        TaxVersion[]
}

model TaxVersion {
  id             String   @id @default(cuid())
  documentId     String
  hash           String
  originalHash   String
  original       Bytes
  contentType    String
  text           String
  fetchedAt      DateTime @default(now())
  status         String   @default("PENDING")
  reviewNote     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  documentType   String?
  legalStatus    String?
  publishedAt    DateTime?
  period         String?  // Used only for SINGLE_PERIOD reviews.
  periodMode     String   @default("SINGLE_PERIOD")
  applicabilityNote String?
  entityName     String?
  investmentFrom DateTime?
  investmentThrough DateTime? // Inclusive entry deadline, not legal expiry.
  jurisdiction   String?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  document       TaxDocument @relation(fields: [documentId], references: [id])
  drafts         TaxReviewDraft[]
  chunks         TaxChunk[]
  @@unique([documentId, hash])
}

model TaxChunk {
  id        String @id @default(cuid())
  versionId String
  anchor    String
  text      String
  version   TaxVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  @@index([versionId])
}

model KnowledgeRelease {
  sequence   Int @unique @default(autoincrement())
  id         String @id @default(cuid())
  versionIds String[]
  createdAt  DateTime @default(now())
  createdBy  String
}

model IngestionJob {
  id          String @id @default(cuid())
  sourceId    String
  dedupeKey   String @unique
  status      String @default("QUEUED")
  attempts    Int @default(0)
  createdAt   DateTime @default(now())
  availableAt DateTime @default(now())
  leaseUntil  DateTime?
  leaseToken  String?
  finishedAt  DateTime?
  error       String?
  documentUrl String?
  documentTitle String?
  issuedAt    DateTime?
  result      String?
  source      TaxSource @relation(fields: [sourceId], references: [id])
  @@index([status, availableAt])
}

model TaxConversation {
  id        String @id @default(cuid())
  userId    String
  period    String
  createdAt DateTime @default(now())
  messages  TaxMessage[]
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model TaxMessage {
  id             String @id @default(cuid())
  conversationId String
  role           String
  content        String
  citations      Json
  releaseId      String?
  model          String?
  promptVersion  String?
  createdAt      DateTime @default(now())
  conversation   TaxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model DailyUsage {
  userId String
  day    String
  count  Int @default(0)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, day])
}

model TaxWorkerState {
  id String @id
  heartbeatAt DateTime
  mode String
}

model TaxReviewDraft {
  versionId String
  userId String
  fields Json
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  version TaxVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([versionId, userId])
}
